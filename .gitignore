# ==============================================================================
# Java & Maven (Backend)
# ==============================================================================
**/target/
**/*.class
**/build/

# Logs
*.log
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Crash logs
hs_err_pid*
replay_pid*

# Keep Maven wrapper executable jar
!**/.mvn/wrapper/maven-wrapper.jar

# ==============================================================================
# Node & Frontend (React / Vite)
# ==============================================================================
**/node_modules/
**/dist/
**/dist-ssr/

# Environment and local secret files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vite / Linter caches
.vite/
.eslintcache
.stylelintcache

